#### lmer : Fonction diagnostic d'un modèle mixte linéaire lme4::lmer ####
# used to deploy a standardized diagnostic after a linear mixte modeling

#' get_detail_LMM
#' 
#' Get detail and diagnostic graph for a linear mixed modeling
#' 
#' @param model [lmerMod / lmerModLmerTest]: A 'lme4::lmer' or 'lmerTest::lmer' model
#' @param IDENT_PAT [character]: The column name identifying the clustering unit 
#'   (e.g. patient ID) used for the random effect, and used to label gg6_Cooks_Distances.
#' 
#' @return A named list.
#' 
#'   tab_coef : fixed effects (broom.mixed::tidy, effects = "fixed"), including estimate, 
#'     std.error, statistic, df, p.value (Satterthwaite, via internal conversion to 
#'     lmerModLmerTest if needed), conf.low, conf.high.
#'   
#'   tab_glance : provide several metrics including :
#'   
#'     isSingular : TRUE if the model fit is singular, i.e. variances of one or more 
#'       linear combinations of random effects are (close to) zero. A singular fit usually 
#'       indicates an over-parameterized random effects structure (too many random slopes/
#'       intercepts relative to the data) and warrants simplifying the random effects.
#'     N : number of observations used in the model's dataset.
#'     norm_conclu : normality test on residuals.
#'       Uses Shapiro-Wilk if N <= 5000, Kolmogorov-Smirnov otherwise. If conclu = "ok" 
#'       (pval > 0.05), residuals are considered normally distributed.
#'     Disp_sim_pval / Disp_sim_conclu : DHARMa::testDispersion, tests global over/under-
#'       dispersion via simulated residuals. Mostly relevant for GLMM (Poisson, binomial) 
#'       where variance is constrained by the mean. If conclu = "ok" (pval > 0.05), 
#'       no dispersion issue detected.
#'     TestQuantiles_pval / TestQuantiles_conclu : DHARMa::testQuantiles, tests whether 
#'       residual variance changes across the range of fitted values (heteroscedasticity 
#'       pattern, "cone/funnel" shape). Complementary to Disp_sim. If conclu = "ok" 
#'       (pval > 0.05), residual variance appears homogeneous across fitted values.
#'     heteroscedasticity_p / heteroscedasticity_conclu : performance::check_heteroscedasticity, 
#'       alternative heteroscedasticity check. Not fully validated for all merMod cases; 
#'       verify it runs correctly on your model class/version before relying on it.
#'     n_pred : number of fixed-effect predictor terms in the model.
#'     multicol_conclu : "ok"/"fail" based on adjusted VIF (SE_factor, from 
#'       performance::multicollinearity) > sqrt(5). "ok" by default if less than 2 predictors 
#'       (vif_info is then NULL). Uses adjusted VIF rather than raw VIF, as it is the only 
#'       metric comparable across numeric predictors and categorical predictors with >2 levels 
#'       (Fox & Monette 1992).
#'   
#'   vif_info : output of performance::multicollinearity(), NULL if less than 2 predictors.
#'     Report and interpret SE_factor (adjusted VIF), not raw VIF, as soon as the model 
#'     contains a categorical predictor with 3+ levels.
#'
#'   patch_gg_diag : Graphs gathered in a patchwork 
#'     gg1_Fitted_vs_Residual : residuals vs fitted values. Randomly dispersed around 0, 
#'       no funnel/cone shape expected if homoscedasticity is respected.
#'     gg2_Scale_Location : sqrt(|residuals|) vs fitted values. An increasing trend suggests 
#'       heteroscedasticity.
#'     gg3_Density_Residuals and gg4_norm_qqplot : used to check normality of residuals 
#'       (fixed-effect level, i.e. model residuals).
#'     gg7_ranef_qqplot : QQ-plot of the random effects (BLUPs), faceted by grouping variable 
#'       and term (intercept / slope). Checks the normality assumption on the random effects 
#'       themselves — distinct from, and complementary to, residual normality (gg3/gg4).
#'     gg5_Residuals_vs_Leverage : residuals vs hat values (.hat), presents residuals and 
#'       their influence / aberrant observations.
#'     gg6_Cooks_Distances : Cook's distance by observation (grouped/labeled by IDENT_PAT). 
#'       A distance greater than 0.5 (or 1) is problematic.
#'   
#'   quick_advice : accumulates all detected issues (residual normality, dispersion, 
#'     heteroscedasticity pattern, multicollinearity, singular fit) into a single message; 
#'     returns "Good!" only if none of these checks fail.
#' 
#' @example
#' iris_mm <- iris
#' iris_mm$IDENT_PAT <- as.factor(rep(1:(nrow(iris)/3), each = 3))
#' iris_mm$Visite_fact <- as.factor(rep(1:3, 50))
#' iris_mm$Visite_time <- as.numeric(iris_mm$Visite_fact)
#' form_i <- "Sepal.Length ~ Sepal.Width + Visite_fact + (Visite_time|IDENT_PAT)"
#' lmmodel <- lme4::lmer(
#'   as.formula(form_i),
#'   data = iris_mm,
#'   REML = FALSE,
#'   control = lmerControl(optimizer ='optimx', optCtrl=list(method='L-BFGS-B'))
#' )
#' mmodel # model evaluated
#' # then get the diag :
#' diag_model <- get_detail_LMM(mmodel)
#' diag_model$patch_gg_diag
#' diag_model$tidy_summary
#' diag_model$tab_glance
#' diag_model$tab_coef
#' 
get_detail_LMM <- function(model, IDENT_PAT = "IDENT_PAT") {
  
  message("[get_detail_LMM] Detail for Linear mixted models ")
  # stopifnot(class(model) %in%  c("lmerMod", "lmerTest", "lmerModLmerTest"))
  stopifnot(inherits(model, c("lmerMod", "lmerTest", "lmerModLmerTest")))
  message(
    "[get_detail_LMM] lme4::lmer ",
    as.character(model@call)[[2]]
  )
  
  # Conversion en lmerModLmerTest si besoin (pour obtenir les p-values Satterthwaite)
  model_lmertest <- if (!inherits(model, "lmerModLmerTest")) {
    lmerTest::as_lmerModLmerTest(model)
  } else {
    model
  }
  
  #### Get coef ####
  
  # tab_coef <- as.data.frame(
  #   lmerTest:::get_coefmat(model)
  # ) %>%
  #   tibble::rownames_to_column() %>%
  #   dplyr::rename(fixed_effect = rowname)
  # 
  # tab_coef$lowerCI <- tab_coef$Estimate - 1.96 * tab_coef$`Std. Error`
  # tab_coef$upperCI <- tab_coef$Estimate + 1.96 * tab_coef$`Std. Error`
 
  tab_coef <- broom.mixed::tidy(
    model_lmertest, effects = "fixed", conf.int = TRUE
  )
  
  tab_augment <- broom.mixed::augment(model)
  # names(tab_augment)[grep(IDENT_PAT, names(tab_augment))] <- "IDENT_PATIENT"
  ## grep partiel, risky
  names(tab_augment)[names(tab_augment) == IDENT_PAT] <- "IDENT_PATIENT"
  
  # A more precise estimate is obtained on the basis of the "Pearson residuals"
  # Pearson residuals are residues standardized by
  # the theoretical standard deviation of the predicted values
  # tab_augment$resid_pearson <- residuals(model, type = "pearson")
  # all(tab_augment$resid_pearson == tab_augment[[".resid"]])
  # head(as.data.frame(tab_augment))
  
  #### Check hypothesis model ####
  
  ## diag message isSingular ##
  # lme4::isSingular(model2) #
  ## --interpretation
  ## if TRUE model is singular i.e.
  ## variances of one or more linear combinations of effects are (close to) zero.
  
  tab_glance <- cbind(
    broom.mixed::glance(model),
    data.frame(isSingular = lme4::isSingular(model))
  )
  tab_glance$N <- nrow(model@frame)
  
  if (tab_glance$N > 5000) {
    tab_glance$ks_resid_pval <- ks.test(
      unique(residuals(model)), "pnorm",
      mean = mean(residuals(model)), sd = sd(residuals(model))
    )$p.value
    tab_glance$norm_conclu <- ifelse(
      tab_glance$ks_resid_pval > 0.05, "ok", # normal
      "fail"
    )
  } else {
    tab_glance$Shapi_resid_pval <- shapiro.test(residuals(model))$p.value
    # if p-valeur > 0.05 => residuals appear as normally distributed => ok
    # Fr : cela suggère que la normalité est respectée 
    tab_glance$norm_conclu <- ifelse(
      tab_glance$Shapi_resid_pval > 0.05, "ok", # normal
      "fail"
    )
  }
  # alt 
  # performance::check_normality(model)
  
  ## homosc?
  
  sim_res <- DHARMa::simulateResiduals(model, plot = FALSE)
  
  # Test de dispersion globale (sur/sous-dispersion) : 
  # pertinent surtout pour GLMM (Poisson, binomial) où la variance est contrainte par la moyenne.
  disp_test <- DHARMa::testDispersion(sim_res, plot = FALSE)
  tab_glance$Disp_sim_pval <- disp_test$p.value
  tab_glance$Disp_sim_conclu <- ifelse(
    tab_glance$Disp_sim_pval > 0.05, "ok", "fail"
  )
  
  # Test de pattern d'hétéroscédasticité (variance qui change selon les valeurs prédites) :
  # complémentaire à testDispersion, plus proche du diagnostic "cone/entonnoir" recherché en LM classique.
  # Si significatif (p < 0.05),
  # la variance des résidus n'est pas homogène le long du gradient de valeurs prédites.
  quantile_test <- DHARMa::testQuantiles(sim_res, plot = FALSE)
  tab_glance$TestQuantiles_pval <- quantile_test$p.value
  tab_glance$TestQuantiles_conclu <- ifelse(
    tab_glance$TestQuantiles_pval > 0.05, "ok", "fail"
  )

  # alt 
  test_heterosc <- performance::check_heteroscedasticity(model)
  tab_glance$heteroscedasticity_p <- as.numeric(test_heterosc)
  tab_glance$heteroscedasticity_conclu <- ifelse(
    tab_glance$heteroscedasticity_p > 0.05, 
    "ok", 
    "fail"
  )
  
  #### Multicolinéarité ####
  tab_glance$n_pred <- length(attr(terms(model), "term.labels"))
  if (tab_glance$n_pred >= 2) {
    # important ++ dans les reg logistique
    # vif_info <- car::vif(model)
    vif_info <- performance::multicollinearity(model)
    # use adjusted VIF = SE_factor
    # Interprétation
    # If every predictor in your model is numeric or a 2-level factor, 
    # VIF and adjusted VIF tell you the same story
    # As soon as you have any categorical predictor with 3+ levels 
    # you should report and interpret the adjusted VIF, 
    # using the √-thresholds (when thresholds can be 3, 5, 10 commonly)
    # eg. adjusted GVIF > 3.16, corresponding to a conventional VIF > 10 ...
    tab_glance$multicol_conclu <- ifelse(
      any(vif_info$SE_factor>sqrt(5)), # sqrt(5)  # ≈ 2.236
      "fail", 
      "ok"
    )
  } else {
    vif_info <- NULL
    tab_glance$multicol_conclu <- "ok"
  }
  
  
  #### Graphs ####
  
  #### gg1 Fitted_vs_Residual ####
  
  ## Hyp 1 ## homoscédasticité des résidus
  ## fitted vs residual with smooth line added
  # plot(model)
  # plot(
  #   model, type=c("p","smooth"), col.line=1,
  #   main = "Fitted vs Residual"
  # )
  gg1_Fitted_vs_Residual <- ggplot2::ggplot(tab_augment, aes(x = .fitted, y = .resid)) +
    ggplot2::geom_point() +
    ggplot2::geom_hline(yintercept = 0, linetype = "dashed", color = "black") +
    ggplot2::geom_smooth(method = 'loess', se = FALSE) +
    ggplot2::ggtitle("Fitted vs Residual") +
    # ggplot2::labs(y = "Pearson residuals") +
    ggplot2::theme_light()
  gg1_Fitted_vs_Residual
  ## --interpretation
  ## If the residues are randomly dispersed around the 0 line, the relationship is linear and the mean of the residues is 0. ; good news
  ## If the residues form an approximate horizontal band around the 0 line, the residue variance is homogeneous (therefore, they are homoscedastic). ; good news
  ## If the residues are organized in funnel form, the residues are not homoscedastic. ; heterosedasticity problem
  
  #### gg2 Scale_Location ####
  
  ## Hyp 2 ## scale-location plot = Échelle localisée
  # plot(
  #   model,
  #   sqrt(abs(resid(.)))~fitted(.), type=c("p","smooth"),
  #   col.line=1, main = "Scale-Location"
  # )
  gg2_Scale_Location <- ggplot2::ggplot(
    data = tab_augment, aes(x = .fitted, y = sqrt(abs(.resid)))
  ) +
    ggplot2::geom_point() +
    ggplot2::geom_smooth(method = 'loess', se = FALSE) +
    ggplot2::ggtitle("Scale-Location") +
    ggplot2::theme_light()
  gg2_Scale_Location
  ## --interpretation :
  # check whether residue dispersion increases for a given predicted value
  # If the dispersion increases, the basic condition of homoscedasticity is not met
  # Not a good news if marked trend
  
  #### gg3 gg4 norm ####
  
  ## Hyp 3 ## Normalité des résidus + viz Q-Q plot
  
  ## shapiro.test(residuals(model))
  ## --interpretation shapiro :
  ## p<0.05 => The assumption of normality is therefore rejected
  ## p>0.05 => no proof of non normality = normality is therefore tolerated
  
  # hist(residuals(model),breaks = 20)
  ## ggplot density
  gg3_Density_Residuals <- ggpubr::ggdensity(
    tab_augment[[".resid"]]
  ) +
    ggplot2::labs(
      title = "Density plot for residuals",
      subtitle = paste0("shapiro.test p=", formatC(tab_glance$Shapi_resid_pval)),
      x = "Residuals"
    ) +
    ggplot2::theme_light()
  gg3_Density_Residuals
  # qqnorm(residuals(model))
  # qqline(residuals(model))
  ## also : lattice::qqmath(model)
  ## ggplot qqnorm
  gg4_norm_qqplot <- ggpubr::ggqqplot(tab_augment[[".resid"]], add = "qqline") +
    ggplot2::ggtitle(
      paste0("Normal qqplot"),
      subtitle = paste0(
        "N=", length(tab_augment[[".resid"]])
      )
    ) +
    ggplot2::theme_light()
  gg4_norm_qqplot
  
  #### gg5 gg5 Leverage CookD ####
  
  ## Hyp 4 ## residuals vs leverage = Résidus vs effet de levier
  
  # plot(model, rstudent(.) ~ hatvalues(.), main = "residuals vs leverage")
  gg5_Residuals_vs_Leverage <- ggplot2::ggplot(
    data = tab_augment,
    mapping = aes(x = .hat, y = .resid)
  ) +
    ggplot2::geom_point() +
    ggplot2::geom_vline(
      xintercept = 2 * mean(tab_augment[[".hat"]], na.rm = TRUE),
      linetype = "dashed", color = "pink"
    ) + 
    ggplot2::ggtitle("Residuals vs Leverage") +
    ggplot2::theme_light()
  gg5_Residuals_vs_Leverage
  
  ## --interpretation
  ## presents the residues and their influence or aberrant observations
  ## distance Cook: A distance greater than 0.5 is problematic.
  
  # sum(cooks.distance(model) > 0.5)
  # plot(cooks.distance(model))
  gg6_Cooks_Distances <- ggplot2::ggplot(
    data = tab_augment,
    mapping = aes(y = .cooksd, x = IDENT_PATIENT)
  ) +
    ggplot2::geom_point() +
    ggplot2::geom_hline(yintercept = 0.5, linetype="dashed", color = "pink") +
    ggplot2::geom_hline(yintercept = 1, linetype="dashed", color = "red") +
    ggplot2::labs(
      x = "",
      title = "Cooks Distances",
      subtitle = paste0(
        "N=", nrow(tab_augment),
        " / n=", sum(tab_augment[[".cooksd"]] > 1,na.rm = TRUE), " cook's dist > 1."
      )
    ) +
    ggplot2::scale_x_discrete(labels = NULL, breaks = NULL) +
    ggplot2::theme_light()
  gg6_Cooks_Distances
  ## A rule of thumb is that an observation has high influence 
  # if Cook’s distance exceeds 4/(n - p - 1)(P. Bruce and Bruce 2017),
  # where n is the number of observations and p the number of predictor variables.
  ## other rule : percentile : 10-20 %
  # tmp_per <- as.data.frame(quantile(tab_augment[[".cooksd"]], c(0.1, 0.2)))
  # if (sum(tab_augment[[".cooksd"]] > tmp_per[1,1], na.rm = TRUE) > 0) {
  #   gg6_Cooks_Distances <- gg6_Cooks_Distances + 
  #     ggplot2::geom_hline(yintercept = tmp_per[2,1], linetype="dashed", color = "grey20") +
  #     ggplot2::geom_hline(yintercept = tmp_per[1,1], linetype="dashed", color = "grey10")
  # }
  gg6_Cooks_Distances <- gg6_Cooks_Distances + 
    ggplot2::geom_hline(yintercept = 4/nrow(tab_augment), linetype = "dashed", color = "grey20") 
  gg6_Cooks_Distances
  
  
  #### gg7 QQ-plot des effets aléatoires (BLUPs) ####
  
  ## Normalité des effets aléatoire ##
  
  # gg7_ranef_qqplot <- lattice::qqmath(lme4::ranef(model))
  
  ranef_df <- as.data.frame(lme4::ranef(model))
  # colonnes attendues : grpvar, term, grp, condval, condsd
  
  gg7_ranef_qqplot <- ggplot2::ggplot(ranef_df, ggplot2::aes(sample = condval)) +
    ggplot2::stat_qq() +
    ggplot2::stat_qq_line() +
    ggplot2::facet_wrap(~ grpvar + term, scales = "free") +
    ggplot2::labs(
      title = "QQ-plot of random effects (BLUPs)",
      x = "Theoretical quantiles", y = "Random effect estimates"
    ) +
    ggplot2::theme_light()
  gg7_ranef_qqplot
  
  #### patchwork ####
  
  # library(patchwork)
  # patch_gg_diag <- (
  #   (gg1_Fitted_vs_Residual + gg2_Scale_Location) /
  #     (gg3_Density_Residuals + gg4_norm_qqplot) /
  #     (gg5_Residuals_vs_Leverage + gg6_Cooks_Distances)
  # )
  patch_gg_diag <- (
    (gg1_Fitted_vs_Residual + gg2_Scale_Location) /
      (gg3_Density_Residuals + gg4_norm_qqplot + gg7_ranef_qqplot) /
      (gg5_Residuals_vs_Leverage + gg6_Cooks_Distances)
  )

  patch_gg_diag <- patch_gg_diag + patchwork::plot_annotation(
    subtitle = paste0(paste0(as.character(model@call)[1:2], collapse = "("), ")")
    # title = '',
    # subtitle = '',
    # caption = 'Disclaimer: ...'
  )
  
  patch_gg_diag
  
  #### quick_advice ####
  
  quick_advice <- "NotGood!"
  if (tab_glance$norm_conclu %in% "ok" & tab_glance$heteroscedasticity_p > 0.05) {
    message("[get_detail_LMM] Normality ok and homoscedasticity ok")
    quick_advice <- "Good! Normality ok and homoscedasticity ok."
  }
  if (tab_glance$norm_conclu %in% "fail" & tab_glance$heteroscedasticity_p < 0.05) {
    # Si testDispersion(sim_res) est significatif (p < 0.05) → il y a une hétéroscédasticité.
    message("[get_detail_LMM] Normality fail and homoscedasticity fail")
    quick_advice <- "Normality fail and homoscedasticity fail. Troubleshooting: Try log transformation of Y ?"
  }
  if (tab_glance$norm_conclu %in% "fail" & tab_glance$heteroscedasticity_p > 0.05) {
    message("[get_detail_LMM] Normality fail and homoscedasticity ok")
    quick_advice <- "Normality fail and homoscedasticity ok. Troubleshooting: check/filter extrem .cooksd, see bootstrap... "
  }
  if (isTRUE(tab_glance$isSingular)) {
    quick_advice <- paste(
      quick_advice, 
      "| Singular fit: random effects structure likely over-parameterized (simplify random slopes/intercepts)."
    )
  }
  
  
  
  ## res list
  results <- list(
    "model" = model,
    "call" = model@call,
    "summary" = broom.mixed::tidy(model),
    "vif_info" = vif_info,
    "tab_coef" = tab_coef,
    "tab_glance" = tab_glance,
    # provied each gg or the global patchwork :
    "patch_gg_diag" = patch_gg_diag, 
    "quick_advice" = quick_advice
  )
  
  return(results)
}

#### Exemple LMM ####
if (FALSE) {
  
  iris_mm <- iris
  iris_mm$IDENT_PAT <- as.factor(rep(1:(nrow(iris)/3), each = 3))
  iris_mm$Visite_fact <- as.factor(rep(1:3, 50))
  iris_mm$Visite_time <- as.numeric(iris_mm$Visite_fact)
  tail(iris_mm)
  form_i <- "Sepal.Length ~ Sepal.Width + Visite_fact + (Visite_time|IDENT_PAT)"
  mmodel <- lme4::lmer(
    as.formula(form_i),
    data = iris_mm,
    REML = FALSE,
    control = lmerControl(optimizer ='optimx', optCtrl=list(method='L-BFGS-B'))
  )
  mmodel # model evaluated
  model <- mmodel
  # then get the diag :
  diag_model <- get_detail_LMM(mmodel)
  # get each element of the diag more specifically
  # graph patchwork :
  diag_model$patch_gg_diag
  # glance of stats
  diag_model$tab_glance
  # coef table
  diag_model$tab_coef
  # quick adivice to conclude  
  diag_model$quick_advice
  # modele provided in argument, if needed : 
  diag_model$summary
  diag_model$model # = mmodel
  coef_tab <- diag_model$tab_coef
  tabres <- setDT(coef_tab[!coef_tab$term %in% "(Intercept)", ]) # ignore intercept ? 
  tabres[["df"]] <- NULL
  tabres[["statistic"]] <- NULL
  tabres$Y <- "Sepal.Length"
  tabres$form <- form_i
  tabres$ok_norm <- diag_model$tab_glance$norm_conclu %in% "ok"
  tabres$n <- diag_model$tab_glance$N
  
  ## si pb de normalité, test impact val abbérante
  if (!unique(tabres$ok_norm)) {
    # data_graph[.cooksd > 1, ]
    message("=> remove extrem values (.cooksd)")
    data_graph <- setDT(diag_model$patch_gg_diag$patches$plots[[3]]$data)
    
    # retirer les valeurs influentes : hats ? 
    
    # retirer les valeurs abbérantes
    data_graph_mm <- data_graph[.cooksd < 1, ]
    
    data_graph_mm$IDENT_PAT <- data_graph_mm$IDENT_PATIENT
    
    rm(mmodel)
    mmodel <- lme4::lmer(
      as.formula(form_i), 
      data = data_graph_mm
    )
    rm(diag_model)
    diag_model <- get_detail_LMM(mmodel, IDENT_PAT = "IDENT_PAT") # without extreme val
    coef_tab <- diag_model$tab_coef
    message("=> upadate tab res")
    tabres <- setDT(coef_tab[!coef_tab$term %in% "(Intercept)", ]) # ignore intercept ? 
    tabres[["df"]] <- NULL
    tabres[["statistic"]] <- NULL
    tabres$Y <- "Sepal.Length"
    tabres$form <- form_i
    tabres$ok_norm <- diag_model$tab_glance$norm_conclu %in% "ok"
    tabres$n <- nrow(data_graph_mm)
    
    ## bootstrap ##
    if (!unique(tabres$ok_norm)) { 
      message("=> need boot...")
      
      boot_res <- boot.pval::boot_summary(mmodel, R = 999, method = "parametric") # or method = "semiparametric"  
      boot_res <-  setDT(boot_res, keep.rownames = "term")
      boot_res <- boot_res[!boot_res$term %in% "(Intercept)", ] %>% 
        dplyr::rename(estimate_boot = Estimate) %>% 
        dplyr::rename(lowerCI_boot = Lower.bound) %>% 
        dplyr::rename(upperCI_boot = Upper.bound) %>% 
        dplyr::rename(P_valeur_boot = p.value)
      tabres <- merge(tabres, boot_res,by = "term", all = TRUE)
    }
    
  }
  
  tabres
  
}
